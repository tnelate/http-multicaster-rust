# Port the multicaster listens on (default: 8001).
# Avoids colliding with rook-rust local ports (8080 online, 8081 offline, 8082 reporting).
PORT=8001

# Comma-separated list of target base URLs to multicast every incoming HTTP request to.
# Cloud Run -> developer zrok tunnels:
TARGET_ENDPOINTS=https://tnfixfi.share.zrok.io,https://fafixfi.share.zrok.io,https://ikfixfi.share.zrok.io,https://akfixfi.share.zrok.io,https://vdfixfi.share.zrok.io
# Local fan-out example (e.g. forwarding to local 8001 or rook-rust apps):
# TARGET_ENDPOINTS=http://localhost:8001,http://localhost:8081

# Timeouts (in seconds)
REQUEST_TIMEOUT_SECONDS=30
CONNECT_TIMEOUT_SECONDS=5

# Maximum incoming body size in bytes (default: 10 MiB = 10485760)
MAX_BODY_BYTES=10485760

# Maximum characters of request/response body to print in logs (default: 200)
LOG_MAX_BODY_CHARS=200

# Comma-separated fallback HTTP status codes returned only if no endpoint responds with 200..400
FALLBACK_STATUS_CODES=401

# Logging configuration matching rook-rust (LOG_FORMAT: text locally, json in Cloud Run)
LOG_LEVEL=info
LOG_FORMAT=text

